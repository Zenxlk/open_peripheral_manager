/target/
**/*.rs.bk
*.pdb

# Editor / IDE
.idea/
.vscode/
*.swp

# OS cruft
.DS_Store

# Raw USB/HID captures tend to be large binary artifacts; keep the
# analysis (docs/protocols/**/*.md) in git but not the raw dumps.
docs/protocols/**/captures/*
!docs/protocols/**/captures/.gitkeep

# Maintainer's personal Rust-learning notes — kept locally, not part of
# the project's own documentation (see docs/README.md).
/docs/learning/

# Local Claude Code session settings (permission grants, etc.) — not
# project configuration.
/.claude/
